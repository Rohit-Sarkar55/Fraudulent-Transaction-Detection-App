{
  "type": "record",
  "name": "Transaction",
  "namespace": "com.devday.frauddetect.avro",
  "doc": "A single card transaction, produced onto the 'transactions' topic.",
  "fields": [
    { "name": "transaction_id", "type": "string", "doc": "Unique ID for this transaction." },
    { "name": "card_id", "type": "string", "doc": "Masked/tokenized card identifier, e.g. '4471'." },
    { "name": "customer_id", "type": "string", "doc": "Joins against customer_profiles for enrichment." },
    { "name": "amount", "type": "double", "doc": "Transaction amount in USD." },
    { "name": "merchant", "type": "string" },
    { "name": "lat", "type": "double", "doc": "Latitude where the transaction occurred." },
    { "name": "lon", "type": "double", "doc": "Longitude where the transaction occurred." },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Event time, epoch millis."
    },
    {
      "name": "device_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Device fingerprint, added in schema v2. Optional with a null default so this is a backward-compatible change -- existing consumers reading old messages (which have no device_id at all) simply see null, and don't break."
    }
  ]
}
